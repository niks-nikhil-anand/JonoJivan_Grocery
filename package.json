  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate-users": "tsx scripts/migrate-users-to-postgres.ts",
    "db:migrate-users:dry-run": "tsx scripts/migrate-users-to-postgres.ts",
    "db:verify-users": "tsx scripts/verify-users-postgres.ts",
    "db:assert-isolated-targets": "tsx scripts/assert-isolated-restore-targets.ts",
    "db:assert-isolated-postgres": "tsx scripts/assert-isolated-postgres.ts",
    "test:postgres-auth-isolated": "tsx scripts/test-postgres-auth.ts",
    "test:postgres-login-route-isolated": "tsx scripts/test-postgres-login-route.ts",
    "test:postgres-login-route-production-isolated": "set ROUTE_TEST_PRODUCTION=true&& tsx scripts/test-postgres-login-route.ts",
    "test:postgres-session-routes-isolated": "tsx scripts/test-postgres-session-routes.ts",
    "test:postgres-admin-vendor-auth-isolated": "tsx scripts/test-postgres-admin-vendor-auth.ts",
