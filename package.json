    "db:backup-mongodb": "tsx scripts/backup-mongodb.ts",
    "db:migrate-users:apply": "set APPLY=true&& tsx scripts/migrate-users-to-postgres.ts",
    "postinstall": "node -e \"const fs=require('fs'),p='node_modules/buffer-equal-constant-time/index.js';if(fs.existsSync(p)){let c=fs.readFileSync(p,'utf8');if(!c.includes('|| Buffer'))fs.writeFileSync(p,c.replace(/require\\(['\\\"]buffer['\\\"]\\)\\.SlowBuffer;/, 'require(\\'buffer\\').SlowBuffer || Buffer;'));}\""
  },
