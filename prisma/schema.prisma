generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Relational schema for new Prisma-backed features. The existing routes still
// use Mongoose, so migrate data and application code deliberately before using
// Prisma against the production database.

enum UserRole {
  USER
  SUPER_ADMIN
  VENDOR
}

enum AccountStatus {
  BLOCKED
  PENDING
  IN_REVIEW
  ACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
  IN_REVIEW
}

enum AddressType {
  HOME
  WORK
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  ONLINE
}

enum PaymentStatus {
  PAID
  UNPAID
}

enum OrderStatus {
  PENDING
  ORDER_PLACED
  PROCESSING
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PendingOrderStatus {
  PENDING
  FAILED
  COMPLETED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum RechargeType {
  MOBILE
  DTH
}

enum RechargeStatus {
  CREATED
  PAID
  PROCESSING
  SUCCESS
  REFUND_PENDING
  REFUNDED
}

model User {
  id                     String                @id @default(cuid())
  fullName               String
  email                  String                @unique
  mobileNumber           String?
  passwordHash           String?
  isVerified             Boolean               @default(false)
  verificationExpiresAt  DateTime?
  resetPasswordToken     String?
  resetPasswordExpiresAt DateTime?
  profileImage           String?
  role                   UserRole              @default(USER)
  status                 AccountStatus         @default(ACTIVE)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  addresses              Address[]
  carts                  Cart[]
  orders                 Order[]
  pendingOrders          PendingOrder[]
  wishlist               Wishlist?
  vendorProfile          Vendor?
  rechargeTransactions   RechargeTransaction[]
  contactMessages        ContactMessage[]
  usedCoupons            Coupon[]              @relation("CouponUsers")

  @@index([status])
}

model Vendor {
  id                 String        @id @default(cuid())
  userId             String        @unique
  vendorCode         String?       @unique
  businessName       String?
  businessAddress    String?
  aadhaarCardUrl     String?
  panCardUrl         String?
  bankPassbookUrl    String?
  msmeCertificateUrl String?
  gstCertificateUrl  String?
  tradeLicenceUrl    String?
  shopPhotoUrl       String?
  dateOfBirth        DateTime?
  gender             String?
  employeeCount      Int?
  status             AccountStatus @default(PENDING)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id            String         @id @default(cuid())
  userId        String
  firstName     String
  lastName      String
  addressLine1  String
  apartment     String?
  email         String
  mobileNumber  String?
  state         String
  city          String
  landmark      String?
  postalCode    String
  type          AddressType    @default(HOME)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders        Order[]
  pendingOrders PendingOrder[]

  @@index([userId])
}

model Category {
  id            String        @id @default(cuid())
  name          String        @unique
  imageUrl      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  subcategories SubCategory[]
  products      Product[]
  coupons       Coupon[]      @relation("CouponCategories")
}

model SubCategory {
  id            String           @id @default(cuid())
  categoryId    String
  name          String
  imageUrl      String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  category      Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategories SubSubCategory[]
  products      Product[]
  coupons       Coupon[]         @relation("CouponSubCategories")

  @@unique([categoryId, name])
  @@index([categoryId])
}

model SubSubCategory {
  id            String      @id @default(cuid())
  subCategoryId String
  name          String
  imageUrl      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  subCategory   SubCategory @relation(fields: [subCategoryId], references: [id], onDelete: Cascade)
  products      Product[]

  @@unique([subCategoryId, name])
  @@index([subCategoryId])
}

model Product {
  id               String          @id @default(cuid())
  categoryId       String
  subCategoryId    String
  subSubCategoryId String?
  name             String
  slug             String          @unique
  stock            Int             @default(0)
  weightValue      Decimal         @db.Decimal(10, 2)
  weightUnit       String
  description      Json
  salePrice        Decimal         @db.Decimal(12, 2)
  originalPrice    Decimal         @db.Decimal(12, 2)
  featuredImageUrl String
  images           String[]
  averageRating    Decimal         @default(0) @db.Decimal(3, 2)
  ratingCount      Int             @default(0)
  isFeaturedSale   Boolean         @default(false)
  isOnSale         Boolean         @default(false)
  isClearance      Boolean         @default(false)
  isHotDeal        Boolean         @default(false)
  tags             String[]
  status           ProductStatus   @default(IN_REVIEW)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  category         Category        @relation(fields: [categoryId], references: [id])
  subCategory      SubCategory     @relation(fields: [subCategoryId], references: [id])
  subSubCategory   SubSubCategory? @relation(fields: [subSubCategoryId], references: [id])
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
  reviews          Review[]
  coupons          Coupon[]        @relation("CouponProducts")

  @@index([categoryId, status])
  @@index([subCategoryId])
  @@index([subSubCategoryId])
}

model Cart {
  id            String         @id @default(cuid())
  userId        String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         CartItem[]
  pendingOrders PendingOrder[]
  orders        Order[]

  @@index([userId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@index([productId])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
}

model WishlistItem {
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([wishlistId, productId])
  @@index([productId])
}

model PendingOrder {
  id                  String             @id @default(cuid())
  userId              String?
  cartId              String
  addressId           String
  isCheckoutCompleted Boolean            @default(false)
  isShippingConfirmed Boolean            @default(false)
  isPaymentCompleted  Boolean            @default(false)
  status              PendingOrderStatus @default(PENDING)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  user                User?              @relation(fields: [userId], references: [id])
  cart                Cart               @relation(fields: [cartId], references: [id])
  address             Address            @relation(fields: [addressId], references: [id])

  @@index([userId, status])
  @@index([cartId])
}

model Order {
  id                String        @id @default(cuid())
  userId            String?
  cartId            String?
  addressId         String
  invoiceNo         String        @unique
  totalAmount       Decimal       @db.Decimal(12, 2)
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus @default(UNPAID)
  status            OrderStatus   @default(PENDING)
  orderedAt         DateTime      @default(now())
  deliveryDate      DateTime?
  isPaid            Boolean       @default(false)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User?         @relation(fields: [userId], references: [id])
  cart              Cart?         @relation(fields: [cartId], references: [id])
  address           Address       @relation(fields: [addressId], references: [id])
  payment           Payment?

  @@index([userId, status])
  @@index([addressId])
}

model Payment {
  id                String   @id @default(cuid())
  orderId           String   @unique
  razorpayOrderId   String   @unique
  razorpayPaymentId String   @unique
  razorpaySignature String
  createdAt         DateTime @default(now())
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model RechargeTransaction {
  id                String         @id @default(cuid())
  transactionId     String         @unique
  userId            String?
  type              RechargeType
  operator          String
  circle            String?
  subscriberNumber  String
  amount            Decimal        @db.Decimal(12, 2)
  planLabel         String?
  status            RechargeStatus @default(CREATED)
  message           String?
  razorpayOrderId   String?        @unique
  razorpayPaymentId String?        @unique
  refundId          String?        @unique
  providerReference String?
  operatorReference String?
  commissionRate    Decimal?       @db.Decimal(5, 2)
  commissionAmount  Decimal?       @db.Decimal(12, 2)
  paidAt            DateTime?
  processingAt      DateTime?
  completedAt       DateTime?
  lastCheckedAt     DateTime?
  checkCount        Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  user              User?          @relation(fields: [userId], references: [id])

  @@index([status])
  @@index([userId, createdAt])
}

model Coupon {
  id                String        @id @default(cuid())
  code              String        @unique
  discountType      DiscountType
  discountValue     Decimal       @db.Decimal(12, 2)
  description       String?
  startsAt          DateTime
  endsAt            DateTime
  isActive          Boolean       @default(true)
  minimumOrderValue Decimal?      @db.Decimal(12, 2)
  isFreeShipping    Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  categories        Category[]    @relation("CouponCategories")
  subCategories     SubCategory[] @relation("CouponSubCategories")
  products          Product[]     @relation("CouponProducts")
  appliedByUsers    User[]        @relation("CouponUsers")

  @@index([isActive, startsAt, endsAt])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  name      String
  email     String
  rating    Int
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, createdAt])
}

model ContactMessage {
  id           String   @id @default(cuid())
  userId       String?
  firstName    String?
  lastName     String?
  email        String
  mobileNumber String?
  message      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RationCard {
  id                String    @id @default(cuid())
  name              String
  fatherName        String
  profilePictureUrl String?
  uniqueNumber      String    @unique
  whatsappNumber    String?
  email             String?
  aadhaarNumber     String?
  panNumber         String?
  dateOfBirth       DateTime?
  bankAccountNumber String?
  bankIfscCode      String?
  bankName          String?
  address           String?
  state             String?
  postalCode        String?
  issuedAt          DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model PrivacyPolicy {
  id        String   @id @default(cuid())
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ReturnPolicy {
  id        String   @id @default(cuid())
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ShippingPolicy {
  id        String   @id @default(cuid())
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TermsAndConditions {
  id        String   @id @default(cuid())
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id               String   @id @default(cuid())
  featuredImageUrl String
  title            String
  subtitle         String
  category         String
  author           String
  content          Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category, createdAt])
}
